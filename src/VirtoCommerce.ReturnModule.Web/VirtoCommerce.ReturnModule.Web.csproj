<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <NoWarn>NU1608</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Project is not a test project -->
    <SonarQubeTestProject>false</SonarQubeTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="VirtoCommerce.FileExperienceApi.Core" Version="3.1006.0" />
    <PackageReference Include="VirtoCommerce.NotificationsModule.TemplateLoader.FileSystem" Version="3.1018.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Admin Shell plugin: Vue sources in vue/, built into plugins/admin-shell/ -->
    <Compile Remove="vue\**" />
    <Content Remove="vue\**" />
    <EmbeddedResource Remove="vue\**" />
    <None Remove="vue\**" />
    <Content Remove="plugins\**" />
    <None Remove="plugins\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- NSwag emits repeated request/response plumbing; regenerate these clients instead of refactoring them.
         They stay project items so this project-level setting reaches them. -->
    <None Include="vue\src\api_client\virtocommerce.*.ts" />
    <SonarQubeSetting Include="sonar.cpd.exclusions">
      <Value>**/vue/src/api_client/virtocommerce.*.ts</Value>
    </SonarQubeSetting>
  </ItemGroup>
  <ItemGroup>
    <NotificationTemplates Include="NotificationTemplates\**" />
    <AdminShellPlugin Include="plugins\**" />
  </ItemGroup>
  <Target Name="CopyNotificationTemplatesOnPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(NotificationTemplates)" DestinationFiles="$(PublishDir)\..\%(Identity)" />
    <Copy SourceFiles="@(AdminShellPlugin)" DestinationFiles="$(PublishDir)\..\%(Identity)" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.ReturnModule.Core\VirtoCommerce.ReturnModule.Core.csproj" />
    <ProjectReference Include="..\VirtoCommerce.ReturnModule.Data.MySql\VirtoCommerce.ReturnModule.Data.MySql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.ReturnModule.Data.PostgreSql\VirtoCommerce.ReturnModule.Data.PostgreSql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.ReturnModule.Data.SqlServer\VirtoCommerce.ReturnModule.Data.SqlServer.csproj" />
    <ProjectReference Include="..\VirtoCommerce.ReturnModule.Data\VirtoCommerce.ReturnModule.Data.csproj" />
    <ProjectReference Include="..\VirtoCommerce.ReturnModule.ExperienceApi\VirtoCommerce.ReturnModule.ExperienceApi.csproj" />
  </ItemGroup>
</Project>